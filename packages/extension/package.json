{
  "name": "@nashir/extension",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:tokens": "vite-node -c scripts/vite-node.config.ts scripts/write-tokens.ts",
    "pack:ext": "node scripts/pack.mjs",
    "screenshots": "node scripts/screenshots/capture.mjs"
  },
  "dependencies": {
    "@nashir/shared": "workspace:*",
    "@noble/ed25519": "3.2.0",
    "fflate": "0.8.3",
    "i18next": "^26.5.11",
    "idb": "^8.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@material/material-color-utilities": "^0.4.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-node": "^6.0.0",
    "vitest": "4.1.12"
  }
}
